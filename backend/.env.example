FOOD_TRACKER_DATABASE_URL=postgresql+psycopg://food_tracker:food_tracker@127.0.0.1:5432/food_tracker

# Generate the five independent secrets with: uv run python scripts/setup_local_auth.py
# FOOD_TRACKER_ACCESS_JWT_SECRET
# FOOD_TRACKER_REFRESH_JWT_SECRET
# FOOD_TRACKER_CODE_HMAC_SECRET
# FOOD_TRACKER_CSRF_SECRET
# FOOD_TRACKER_MAIL_ENCRYPTION_KEY
FOOD_TRACKER_SMTP_HOST=127.0.0.1
FOOD_TRACKER_SMTP_PORT=1025
# Local Mailpit. External SMTP requires either SSL or STARTTLS plus sender/credentials.
FOOD_TRACKER_SMTP_STARTTLS=false
FOOD_TRACKER_SMTP_SSL=false
# External SMTP credentials are entered only into the ignored .env file.
# FOOD_TRACKER_SMTP_USERNAME=personal-mailbox@example.com
# FOOD_TRACKER_SMTP_PASSWORD=app-password
# FOOD_TRACKER_SMTP_SENDER="Ем по плану <personal-mailbox@example.com>"
FOOD_TRACKER_AUTH_ALLOWED_ORIGINS=["https://localhost:5173","https://127.0.0.1:5173"]
