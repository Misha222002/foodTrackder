# Относительный адрес использует Vite proxy; cookies остаются на том же origin.
VITE_API_BASE_URL=/api/v1
VITE_API_FRESHNESS_SECONDS=30
VITE_ENABLE_MSW=false
# Только для Vite dev proxy, не включается в клиентский bundle.
API_PROXY_TARGET=http://127.0.0.1:8000

# Ссылка на локальный приёмник кодов; отображается только в dev.
# Пустое значение скрывает подсказку при настройке внешнего SMTP.
VITE_DEV_MAILBOX_URL=http://127.0.0.1:8025
